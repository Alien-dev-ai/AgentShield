# AgentShield configuration. Copy to .env for local development.
# All variables use the AGENTSHIELD_ prefix. Never commit a real .env.
# .env is read only in development and test. Production never reads it: set
# real environment variables (AGENTSHIELD_ENVIRONMENT=production included).

# development | test | production
AGENTSHIELD_ENVIRONMENT=development
AGENTSHIELD_DEBUG=false

# Development: SQLite.  Production: postgresql+asyncpg://user:pass@host:5432/agentshield
AGENTSHIELD_DATABASE_URL=sqlite+aiosqlite:///./agentshield.db
# Development only: logs SQL statements (bound parameters are always hidden).
# Rejected at startup in production.
AGENTSHIELD_DB_ECHO=false
AGENTSHIELD_DB_POOL_SIZE=5
AGENTSHIELD_DB_MAX_OVERFLOW=10
AGENTSHIELD_DB_POOL_TIMEOUT_SECONDS=30
AGENTSHIELD_DB_STATEMENT_TIMEOUT_MS=15000
AGENTSHIELD_HEALTH_DB_TIMEOUT_SECONDS=2

# Required in production: a randomly generated key of at least 32 characters.
# Generate one (never reuse an example value):
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Production rejects placeholder text (changeme, secret, example, dev...),
# repeated patterns, character sequences and low-variety keys.
AGENTSHIELD_SECRET_KEY=

# Logging: DEBUG | INFO | WARNING | ERROR ; format: json | console
AGENTSHIELD_LOG_LEVEL=INFO
AGENTSHIELD_LOG_FORMAT=console

# HTTP
AGENTSHIELD_MAX_REQUEST_BODY_BYTES=1048576
# JSON lists
AGENTSHIELD_CORS_ALLOW_ORIGINS=[]
AGENTSHIELD_ALLOWED_HOSTS=["localhost","127.0.0.1","testserver"]
# API docs (/docs, /redoc, /openapi.json). Leave unset: docs are served in
# development/test and are ALWAYS disabled in production (setting this to true
# in production is rejected at startup). Set to false to hide them locally.
# AGENTSHIELD_DOCS_ENABLED=
